# Copy to .env and fill in. Never commit .env.

# Your Anthropic API key (https://platform.claude.com). Without it, both apps run in demo mode.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# CHATQUADRA_MODEL=claude-opus-5-5
# CHATQUADRA_REPLY_EFFORT=low
# CHATQUADRA_ANALYSIS_EFFORT=medium
# CHATQUADRA_ANALYSIS_EVERY=3          # read the user every 3-5 messages
# CHATQUADRA_MIN_WORDS=150             # words before showing a result
# CHATQUADRA_PACE=1.0                  # realistic delay multiplier
# CHATQUADRA_PERSONA_READS_USER=1      # persona gets a private behaviour note
# CHATQUADRA_MAX_MESSAGES_PER_HOUR=120
# CHATQUADRA_MIN_AGE=18
# CHATQUADRA_MOCK=1                    # force demo mode
